{
  "$schema": "https://docs.renovatebot.com/renovate.json5",
  "extends": [
    "config:recommended",
    ":automergeMinor",
    ":automergePatch",
    ":automergeDigest",
    "group:allNonMajor"
  ],
  "schedule": ["before 6am on monday"],
  "timezone": "UTC",
  "gitAuthor": "Renovate Bot <renovate@quantumworld-dpdns-io.example>",
  "commitBodyTable": true,
  "prBodyNotes": [
    "This PR was generated by Renovate Bot.",
    "Check the diff and test results before merging."
  ],
  "packageRules": [
    {
      "matchManagers": ["npm", "pip", "gomod", "cargo"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["docker"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "breaking"]
    },
    {
      "matchDepTypes": ["action"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["terraform"],
      "groupName": "Terraform providers"
    }
  ]
}
