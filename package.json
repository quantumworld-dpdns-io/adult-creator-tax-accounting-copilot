{
  "name": "Adult Creator Tax & Accounting Copilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:webhook": "tsx watch services/webhook-router/src/index.ts",
    "dev:frontend": "next dev apps/web",
    "dev:tax-engine": "cd services/tax-engine && python -m uvicorn app:app --reload",
    "build": "tsc -b && next build",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "robot": "robot tests/robot",
    "owasp": "robot --variable ENV:ci tests/robot/owasp",
    "mcp:py": "python -m mcp_server_python",
    "mcp:go": "cd services/mcp-server-go && go run ./cmd/mcp-server-go",
    "mcp:node": "tsx services/mcp-server-node/src/cli.ts",
    "mcp:rust": "cargo run --bin mcp-server-rust -p mcp-server-rust",
    "quantum:sim": "python quantum/run_simulator.py",
    "zk:prove": "nargo prove --workspace zk/"
  }
}
