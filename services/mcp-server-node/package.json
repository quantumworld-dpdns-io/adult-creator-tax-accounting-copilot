{
  "name": "@copilot/mcp-server-node",
  "version": "0.1.0",
  "description": "MCP server for the Adult Creator Tax & Accounting Copilot (Node)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-server-node": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.54.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/jsonwebtoken": "^9.0.7",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0",
    "eslint": "^9.11.0",
    "prettier": "^3.3.0"
  },
  "license": "MIT"
}
