# webhook-router (Node + NestJS)
#
# Receives signed webhooks from all payment platforms (OnlyFans, Fansly,
# Chaturbate, Stripe, Coinbase Commerce, NOWPayments, etc.), verifies the
# signature, deduplicates, and fans out to the ledger + payout-aggregator.

{
  "name": "@copilot/webhook-router",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^10.4",
    "@nestjs/core": "^10.4",
    "@nestjs/platform-express": "^10.4",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "pino": "^9.5.0",
    "jsonwebtoken": "^9.0.2",
    "@copilot/sdk-ts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0"
  }
}
