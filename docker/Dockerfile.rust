# Multi-stage Dockerfile for Rust services.
FROM rust:1.98-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config libssl-dev ca-certificates cmake \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY services/mcp-server-rust/ ./

RUN cargo build --release --bin mcp-server-rust && \
    strip target/release/mcp-server-rust

FROM gcr.io/distroless/cc-debian12
COPY --from=builder /src/target/release/mcp-server-rust /mcp-server-rust
USER nonroot
EXPOSE 8000
ENTRYPOINT ["/mcp-server-rust"]
