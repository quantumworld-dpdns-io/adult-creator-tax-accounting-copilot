{
  "title": "Copilot Service Dashboard",
  "uid": "copilot-service",
  "tags": ["copilot", "service"],
  "panels": [
    {
      "title": "Request Rate (per service)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (service) (rate(http_requests_total[1m]))" }
      ]
    },
    {
      "title": "Error Rate (5xx)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (service) (rate(http_requests_total{status=~\"5..\"}[5m]))" }
      ]
    },
    {
      "title": "p99 Latency",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.99, sum by (le, service) (rate(http_request_duration_seconds_bucket[5m])))" }
      ]
    }
  ]
}
