# Sample environment file - copy to .env and fill in real values.
# DO NOT commit .env with real secrets.

# ── Application ──────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
SERVICE_NAME=adult-creator-tax-copilot

# ── Database ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=copilot
POSTGRES_PASSWORD=changeme
POSTGRES_DB=copilot
POSTGRES_SSLMODE=require

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ── Kafka ────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA=

# ── Object storage (S3 / MinIO) ──────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_BUCKET_DATA=copilot-data
S3_BUCKET_AUDIT=copilot-audit

# ── Vector DBs ───────────────────────────────────────
QDRANT_URL=http://localhost:6333
MILVUS_URL=http://localhost:19530
WEAVIATE_URL=http://localhost:8080
CHROMA_URL=http://localhost:8000

# ── Local LLM ────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
VLLM_HOST=http://localhost:8001
SGLANG_HOST=http://localhost:8002
LMSTUDIO_HOST=http://localhost:1234

# ── Quantum computing ────────────────────────────────
CUDAQ_BACKEND=cpu
QISKIT_AER_BACKEND=statevector
IBM_QUANTUM_TOKEN=
QRNG_PROVIDER=anu
QRNG_API_URL=https://qrng.anu.edu.au/API/jsonI.php

# ── Zero-knowledge ───────────────────────────────────
NOIR_BACKEND=bn254
RISC0_PROVER=local
RISC0_BONSAI_URL=
RISC0_BONSAI_KEY=

# ── WASM runtimes ────────────────────────────────────
WASMTIME_CACHE_DIR=./.cache/wasmtime
SPIN_VERSION=3.0.0

# ── Federated learning ───────────────────────────────
FLOWER_SUPERLINK_GRPC=localhost:9092
NVIDIA_FLARE_SERVER=localhost:8002

# ── Service mesh ─────────────────────────────────────
LINKERD_PROXY_VERSION=stable-2.15
CILIUM_VERSION=1.16.0
TETRAGON_VERSION=1.16.0

# ── PQC keys (will be auto-rotated) ──────────────────
PQC_KYBER_ALG=Kyber1024
PQC_DILITHIUM_ALG=Dilithium5
PQC_KEY_ROTATION_HOURS=24

# ── OAuth2 / OIDC ────────────────────────────────────
OAUTH2_ISSUER=https://auth.quantumworld-dpdns-io.example
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_AUDIENCE=copilot-api

# ── Cloud provider creds (multi-cloud) ───────────────
# Zeabur
ZEABUR_TOKEN=
# Northflank
NORTHFLANK_TOKEN=
# Scaleway
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_PROJECT_ID=
SCW_ORGANIZATION_ID=
# Exoscale
EXOSCALE_API_KEY=
EXOSCALE_API_SECRET=
EXOSCALE_ZONE=ch-gva-2

# ── CI/CD ────────────────────────────────────────────
GH_TOKEN=
RELEASE_PLEASE_TOKEN=
DEPENDABOT_TOKEN=

# ── Observability ────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=copilot
PHOENIX_COLLECTOR_URL=http://localhost:6006
LANGSMITH_API_KEY=
WANDB_API_KEY=
BRAINTRUST_API_KEY=
ARIZE_API_KEY=
ARIZE_SPACE_KEY=

# ── Vault ────────────────────────────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_NAMESPACE=

# ── Redis Dragonfly ──────────────────────────────────
DRAGONFLY_URL=redis://localhost:6379/1
DRAGONFLY_PASSWORD=

# ── Trino ────────────────────────────────────────────
TRINO_URL=http://localhost:8080
TRINO_USER=trino

# ── Polaris catalog ──────────────────────────────────
POLARIS_URI=http://localhost:8181
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=

# ── Teaclave ─────────────────────────────────────────
TEACLAVE_ATTESTATION_URL=http://localhost:1338

# ── KawaiiGPT guard (shadow-AI defense) ──────────────
Kawaiii_GPT_BLOCKLIST=chat.openai.com,claude.ai,bard.google.com,gemini.google.com,poe.com,perplexity.ai
Kawaiii_GPT_EGRESS_PROXY=http://localhost:8888

# ── Federated learning ───────────────────────────────
FL_DP_EPSILON=1.0
FL_DP_DELTA=1e-5
FL_CLIENTS_PER_ROUND=10

# ── Iris scanner (PII) ───────────────────────────────
PII_SCAN_ENABLED=true
PII_REDACTION_STRATEGY=tokenize

# ── Cost guards ──────────────────────────────────────
COST_CEILING_DAILY_USD=500
COST_CEILING_MONTHLY_USD=10000

# ── Feature flags ────────────────────────────────────
FF_QUANTUM_ENABLED=true
FF_ZK_ENABLED=true
FF_FL_ENABLED=true
FF_TEACLAVE_ENABLED=false
